# Base URL of the PHP API (backend-php/). "/api" works when the frontend and
# the API are deployed under the same domain (e.g. api uploaded to /api on
# the same hosting account) — the recommended, CORS-free setup. Use a full
# URL (https://api.example.com/api) only if the API is on a different domain.
NEXT_PUBLIC_API_URL=/api

# Public origin of the site, used for canonical URLs and the sitemap
NEXT_PUBLIC_SITE_URL=https://akhavan-safaei.ir
