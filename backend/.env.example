DB_HOST=127.0.0.1
DB_NAME=akhavan_safaei
DB_USER=akhavan_app
DB_PASS=change-me

# Long random string — used to sign admin login tokens.
JWT_SECRET=change-me-to-a-long-random-string

ADMIN_USERNAME=admin
# Generate with bin/generate-password-hash.php (see README), never store the plain password here.
ADMIN_PASSWORD_HASH=

# Origin(s) allowed to call this API, comma-separated. "*" allows any origin (fine here: no cookies are used, auth is a Bearer token).
ALLOWED_ORIGIN=*
